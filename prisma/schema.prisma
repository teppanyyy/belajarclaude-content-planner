generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id            Int       @id @default(autoincrement())
  theme         String
  title         String
  caption       String?   @db.Text
  imagePrompt   String?   @db.Text
  imageDataUrl  String?   @db.Text
  done          Boolean   @default(false)
  scheduledDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdAt])
}

// Singleton row (id is always 1) holding the editable brand visual style
// guide used to build every generated image prompt.
model BrandSettings {
  id         Int      @id @default(1)
  styleGuide String   @db.Text
  updatedAt  DateTime @updatedAt
}
