# Postgres connection string (Vercel Postgres / Neon / Supabase all work)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Anthropic API key for caption + image prompt generation
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI API key for actually rendering the generated image prompts into images
OPENAI_API_KEY="sk-proj-..."
